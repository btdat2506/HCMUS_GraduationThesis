---
config:
  theme: redux
---
flowchart TD
    subgraph BootSequence["🚀 System Boot Sequence"]
        Reset["System Reset<br/>Power-On or Manual"]
        BootROM["BootROM Execution<br/>0x10000<br/>First-stage bootloader"]
        DDRCalib["DDR Calibration<br/>MIG Controller Init"]
        SDLoad["Load from SD Card<br/>Second-stage bootloader"]
        LinuxBoot["Linux Kernel Boot<br/>Device Tree Init"]
        UserSpace["User Space<br/>Applications"]
        
        Reset --> BootROM
        BootROM --> DDRCalib
        DDRCalib --> SDLoad
        SDLoad --> LinuxBoot
        LinuxBoot --> UserSpace
    end
    
    subgraph IRQFlow["🔗 Interrupt Architecture"]
        direction TB
        
        subgraph ExtSources["External Interrupt Sources"]
            UART_IRQ["📟 UART IRQ<br/>RX/TX Events"]
            SD_IRQ["💾 SD Card IRQ<br/>Transfer Complete"]
            ETH_IRQ["🌐 Ethernet IRQ<br/>Packet RX/TX"]
            THERMAL_IRQ["🌡️ Thermal IRQ<br/>Temperature Alert"]
        end
        
        PLIC_Core["🔗 PLIC<br/>Platform Level IRQ Controller<br/>0xC000000-0xFFFFFFF"]
        
        subgraph CoreIRQ["Core Interrupt Handling"]
            CPU_IRQ["RISC-V CPU<br/>External IRQ Pin"]
            IRQ_Handler["Linux IRQ Handler<br/>Kernel Interrupt Service"]
            Driver["Device Drivers<br/>UART, SD, ETH, Thermal"]
        end
        
        subgraph TimerIRQ["Timer Interrupts"]
            CLINT_Core["⏰ CLINT<br/>Core-Local Interrupt<br/>0x2000000-0x200FFFF"]
            Timer["System Timer<br/>1ms Tick"]
            Scheduler["Linux Scheduler<br/>Process Switching"]
        end
        
        %% External IRQ Flow
        UART_IRQ --> PLIC_Core
        SD_IRQ --> PLIC_Core
        ETH_IRQ --> PLIC_Core
        THERMAL_IRQ --> PLIC_Core
        
        PLIC_Core --> CPU_IRQ
        CPU_IRQ --> IRQ_Handler
        IRQ_Handler --> Driver
        
        %% Timer IRQ Flow
        CLINT_Core --> Timer
        Timer --> CPU_IRQ
        Timer --> Scheduler
    end
    
    subgraph DebugFlow["🐛 Debug Interface"]
        JTAG["JTAG Interface<br/>External Debugger"]
        DebugModule["Debug Module<br/>0x0-0xFFF"]
        CPU_Debug["CPU Debug Registers<br/>Breakpoints, Step"]
        GDB["GDB Remote<br/>Source-level Debug"]
        
        JTAG --> DebugModule
        DebugModule --> CPU_Debug
        CPU_Debug --> GDB
    end
    
    %% Boot Dependencies
    BootROM -.->|Loads| SDLoad
    DDRCalib -.->|Enables| LinuxBoot
    
    %% System Interactions
    UserSpace -.->|Generates| UART_IRQ
    UserSpace -.->|Triggers| SD_IRQ
    UserSpace -.->|Uses| ETH_IRQ
    
    %% Styling
    classDef bootStyle fill:#e8f5e8,stroke:#2e7d32,stroke-width:2px
    classDef irqStyle fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    classDef coreStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef debugStyle fill:#fce4ec,stroke:#ad1457,stroke-width:2px
    classDef flowStyle stroke:#9e9e9e,stroke-width:1px,stroke-dasharray: 3 3
    
    class Reset,BootROM,DDRCalib,SDLoad,LinuxBoot,UserSpace bootStyle
    class UART_IRQ,SD_IRQ,ETH_IRQ,THERMAL_IRQ,PLIC_Core,CLINT_Core,Timer irqStyle
    class CPU_IRQ,IRQ_Handler,Driver,Scheduler coreStyle
    class JTAG,DebugModule,CPU_Debug,GDB debugStyle